begin mrbayes;
  [fecha o programa sozinho no fim e grava tudo o que aparece na tela]
  set autoclose=yes nowarn=yes;
  log start filename=anolis_ND2_log.txt replace;

  [grupo externo: so muda o desenho da arvore, a analise e sem raiz]
  outgroup BR_ACB.CHUNB14548;

  [particoes: cada posicao do codon do ND2]
  charset ND2_pos1 = 1-924\3;
  charset ND2_pos2 = 2-924\3;
  charset ND2_pos3 = 3-924\3;
  partition codons = 3: ND2_pos1, ND2_pos2, ND2_pos3;
  set partition = codons;

  [modelo: nst=mixed deixa o MrBayes percorrer os modelos de substituicao;
   rates=invgamma: sitios invariaveis + gama]
  lset applyto=(all) nst=mixed rates=invgamma;
  unlink statefreq=(all) revmat=(all) shape=(all) pinvar=(all);
  prset applyto=(all) ratepr=variable;

  [MCMC: 2 corridas independentes, 4 cadeias cada, 100 mil geracoes,
   uma amostra a cada 100 geracoes; descarta os primeiros 25% (burn-in)]
  mcmc ngen=100000 nruns=2 nchains=4 samplefreq=100 printfreq=1000
       diagnfreq=1000 relburnin=yes burninfrac=0.25;

  [resumo dos parametros (PSRF, ESS)]
  sump;

  [arvore de consenso de maioria de 50%: a que interpretamos e publicamos]
  sumt;

  [consenso com todos os clados compativeis: arvore binaria, so para o mPTP]
  sumt contype=allcompat conformat=simple outputname=anolis_ND2_allcompat;

  log stop;
end;
